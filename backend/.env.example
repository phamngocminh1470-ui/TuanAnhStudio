# Google Gemini API Key (Bắt buộc cho Chat & Sinh bài tập)
# Lấy miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Tùy chọn - Dùng cho STT Whisper tốc độ cao)
# Lấy miễn phí tại: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Azure Speech Key & Region (Tùy chọn - Dùng cho Chấm phát âm & Azure TTS tự nhiên)
# Lấy gói F0 (Miễn phí) tại Azure Portal
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=southeastasia
